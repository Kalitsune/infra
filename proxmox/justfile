default: plan

init:
    tofu init

plan:
    tofu plan

apply:
    tofu apply

destroy:
    tofu destroy

fmt:
    tofu fmt -recursive

validate: fmt
    tofu validate

apply-truenas:
    tofu apply -target proxmox_download_file.truenas_iso -target proxmox_virtual_environment_vm.truenas

apply-homeassistant:
    tofu apply -target proxmox_virtual_environment_vm.homeassistant -target terraform_data.haos_disk_import

destroy-truenas:
    tofu destroy -target proxmox_virtual_environment_vm.truenas -target proxmox_download_file.truenas_iso

destroy-homeassistant:
    tofu destroy -target terraform_data.haos_disk_import -target proxmox_virtual_environment_vm.homeassistant

apply-talos:
    tofu apply -target proxmox_download_file.talos_iso -target proxmox_virtual_environment_vm.talos_controlplane -target proxmox_virtual_environment_vm.talos_worker

destroy-talos:
    tofu destroy -target proxmox_virtual_environment_vm.talos_worker -target proxmox_virtual_environment_vm.talos_controlplane -target proxmox_download_file.talos_iso

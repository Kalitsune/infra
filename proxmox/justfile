default: plan

init:
    tofu init

plan:
    tofu plan

apply:
    tofu apply

destroy:
    tofu destroy

fmt:
    tofu fmt -recursive

validate: fmt
    tofu validate

apply-truenas:
    tofu apply -target proxmox_download_file.truenas_iso -target proxmox_virtual_environment_vm.truenas

apply-homeassistant:
    tofu apply -target proxmox_download_file.haos_image -target proxmox_virtual_environment_vm.homeassistant

destroy-truenas:
    tofu destroy -target proxmox_virtual_environment_vm.truenas -target proxmox_download_file.truenas_iso

destroy-homeassistant:
    tofu destroy -target proxmox_virtual_environment_vm.homeassistant -target proxmox_download_file.haos_image

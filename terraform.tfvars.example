proxmox_endpoint    = "https://192.168.1.161:8006"
proxmox_api_token   = "root@pam!opentofu=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node        = "pve"
proxmox_storage     = "local-lvm"
